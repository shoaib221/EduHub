{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "provider": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "transactionId": {
      "type": "string"
    },
    "paidAmount": {
      "type": "decimal"
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "pending ",
        "paid",
        "cancelled",
        "failed"
      ]
    },
    "course_enrollment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-enrollment.course-enrollment",
      "mappedBy": "payment"
    }
  }
}
